# TRUSION AI — Environment Variables Example
# Copy this file to .env and fill in your actual values.
# NEVER commit .env to version control.

# ─── General ───────────────────────────────────────────────
NODE_ENV=production
PORT=3000

# ─── Frontend ───────────────────────────────────────────────
# The production origin of your Cloudflare Pages site.
# Used by the backend for CORS allowlisting.
FRONTEND_ORIGIN=https://trusion.pages.dev

# ─── Supabase ──────────────────────────────────────────────
# From Supabase Dashboard → Settings → API
SUPABASE_URL=https://your-project.supabase.co
# Public anon key — safe to expose in browser code
SUPABASE_ANON_KEY=your-supabase-anon-key
# Service role key — SERVER-SIDE ONLY. NEVER expose in browser code.
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# ─── Anthropic AI ───────────────────────────────────────────
# Server-side only. NEVER expose in browser code or client bundles.
ANTHROPIC_API_KEY=your-anthropic-api-key

# ─── Database (if using direct PostgreSQL connection) ───────
# Only needed if not using Supabase client library
DATABASE_URL=postgresql://user:password@host:5432/dbname

# ─── Payment Gateway ───────────────────────────────────────
# Configure ONE provider. Leave others empty if unused.
# Xendit
XENDIT_SECRET_KEY=your-xendit-secret-key
XENDIT_PUBLIC_KEY=your-xendit-public-key
XENDIT_WEBHOOK_TOKEN=your-xendit-webhook-verification-token
# Midtrans
MIDTRANS_SERVER_KEY=your-midtrans-server-key
MIDTRANS_CLIENT_KEY=your-midtrans-client-key

# ─── Webhook Verification ──────────────────────────────────
# Shared secret for verifying payment gateway webhooks
PAYMENT_WEBHOOK_SECRET=your-webhook-secret

# ─── Optional: Event Logging ───────────────────────────────
# Set to a Supabase Edge Function URL or logging service to forward events
EVENT_LOG_ENDPOINT=
