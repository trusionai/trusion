# TRUSION AI — Environment Variables Example
# Copy to .env for local backend work. NEVER commit .env.
# Production values live in Railway → Variables, not in this file.

# ─── General ────────────────────────────────────────────────
NODE_ENV=production
# Railway injects PORT. Only set it for local runs.
# PORT=3000

# ─── CORS ───────────────────────────────────────────────────
# Exact frontend origin(s), comma-separated. NO wildcards in production.
# With this empty in production, every cross-origin request is rejected
# and the server logs a CONFIG_WARNINGS entry at boot.
FRONTEND_ORIGIN=https://your-project.pages.dev

# ─── Supabase ───────────────────────────────────────────────
# Dashboard → Settings → API
SUPABASE_URL=https://your-project.supabase.co
# Public anon key — safe in browser code, protected by RLS.
# This is also the value you place in public/config.js.
SUPABASE_ANON_KEY=your-supabase-anon-key
# SERVER-SIDE ONLY. Bypasses RLS. Never ship to a browser.
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# ─── Anthropic ──────────────────────────────────────────────
# SERVER-SIDE ONLY. The frontend has no API-key field and never
# calls Anthropic directly. CI fails the build if this leaks.
ANTHROPIC_API_KEY=your-anthropic-api-key

# ─── Database (optional) ────────────────────────────────────
# Only for migrations / raw SQL outside the Supabase client.
DATABASE_URL=postgresql://user:password@host:5432/dbname

# ─── Payment gateway (optional) ─────────────────────────────
# Leave unset to disable billing. While unset, /api/billing/checkout
# returns 503 and no plan is ever upgraded client-side.
# Xendit
XENDIT_SECRET_KEY=
XENDIT_PUBLIC_KEY=
XENDIT_WEBHOOK_TOKEN=
# Midtrans
MIDTRANS_SERVER_KEY=
MIDTRANS_CLIENT_KEY=
# Shared secret compared against the x-callback-token header on
# /api/billing/webhook. Required for any payment to be honoured.
PAYMENT_WEBHOOK_SECRET=

# ─── Tuning (optional) ──────────────────────────────────────
# AI requests per minute per user (default 10)
AI_RATE_LIMIT_PER_MIN=10
# Monthly scan allowance on the free tier (default 10)
FREE_SCAN_QUOTA=10
# Forward structured event logs to an external sink
EVENT_LOG_ENDPOINT=
